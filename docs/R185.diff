+}
+
+/* ---------------- navegación: 5 botones exactos ---------------- */
+function sxgNavItems() {
+  return [
+    { v: 'inicio', l: 'Inicio', ic: 'home' }, { v: 'clientes', l: 'Clientes', ic: 'users' },
+    { v: 'pedidos', l: 'Compras', ic: 'cart' }, { v: 'precios', l: 'Catálogo', ic: 'box' }, { v: 'mas', l: 'Más', ic: 'more' },
